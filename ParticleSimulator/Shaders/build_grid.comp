#version 430 core

layout (local_size_x = 256) in;

struct Particle
{
    vec2 position;
    vec2 velocity;
    vec4 color;
};

layout (std430, binding = 0) readonly buffer ParticleBuffer
{
    Particle particles[];
};

layout (std430, binding = 1) buffer GridHeadBuffer
{
    int gridHeads[];
};

layout (std430, binding = 2) buffer NextParticleBuffer
{
    int nextParticle[];
};

uniform uint particleCount;
uniform int gridColumns;
uniform int gridRows;
uniform float cellSize;
uniform vec2 worldMinimum;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= particleCount)
        return;

    vec2 position = particles[i].position;

    ivec2 cell = ivec2(
        floor((position - worldMinimum) / cellSize)
    );

    if (cell.x < 0 || cell.x >= gridColumns ||
        cell.y < 0 || cell.y >= gridRows)
    {
        nextParticle[i] = -1;
        return;
    }

    int cellIndex = cell.y * gridColumns + cell.x;

    int previous = atomicExchange(gridHeads[cellIndex], int(i));

    nextParticle[i] = previous;
}